# ==========================================
# Server Configuration
# ==========================================
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# ==========================================
# Database & Cache Connections
# ==========================================
# Note: In production or Docker, MongoDB must connect to a replica set for multi-document ACID transactions
MONGO_URI=mongodb://localhost:27017/inventory_db?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# ==========================================
# JWT Authentication & Security
# ==========================================
JWT_SECRET=replace_with_a_secure_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# ==========================================
# BullMQ Background Worker & Queue Policies
# ==========================================
QUEUE_MAX_ATTEMPTS=4
QUEUE_BACKOFF_DELAY_MS=5000
QUEUE_REMOVE_ON_COMPLETE_AGE_SEC=86400
QUEUE_REMOVE_ON_COMPLETE_COUNT=500
QUEUE_REMOVE_ON_FAIL_AGE_SEC=604800
QUEUE_REMOVE_ON_FAIL_COUNT=1000

# ==========================================
# Notification & Scheduled Reports Timing
# ==========================================
# Production: 7200000 (2 hours), Development: 15000 (15 seconds)
LOW_STOCK_FOLLOWUP_DELAY_MS=7200000

# Daily inventory report CRON pattern (Runs at 00:00 UTC)
SCHEDULED_INVENTORY_REPORT_CRON=0 0 * * *

